# ==============================================================================
# AEGIS-Engine Environment Configuration Template
# ==============================================================================

# 1. Database & Server (Required for API & Trace Persistence)
DATABASE_URL=postgresql://postgres:314159@localhost:5432/Aegis
CORS_ORIGINS=http://localhost:3000

# 2. Evaluation Model Provider (Choose Option A or Option B)
# ------------------------------------------------------------------------------
# Option A: Google Gemini via OpenAI-Compatible Endpoint (Already configured in your backend/.env)
AEGIS_JUDGE_API_KEY="your-gemini-api-key"
AEGIS_JUDGE_MODEL="gemini-1.5-flash"
AEGIS_JUDGE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# Option B: OpenAI Direct
# OPENAI_API_KEY="sk-proj-..."
# AEGIS_EVAL_MODEL="gpt-4o"

# 3. LangSmith Live Tracing & Observability (Optional but recommended for evaluation dashboards)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="AEGIS-Multi-Agent-Platform"
LANGCHAIN_API_KEY="ls__your_langchain_api_key"
