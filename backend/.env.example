# ==============================================================================
# AEGIS Platform - Backend Environment Configuration Template
# ==============================================================================

# 1. Database & Server (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis

# Allowed CORS Origins (comma-separated or list)
CORS_ORIGINS=http://localhost:3000

# 2. Evaluation Model Provider (OpenAI / Gemini Compatible)
# Option A: Google Gemini via OpenAI-Compatible Endpoint
AEGIS_JUDGE_API_KEY=your_gemini_or_openai_api_key_here
AEGIS_JUDGE_MODEL=gemini-1.5-flash
AEGIS_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Option B: OpenAI Direct
# OPENAI_API_KEY=sk-...
# AEGIS_EVAL_MODEL=gpt-4o

# 3. Observability & LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=AEGIS-Multi-Agent-Platform
LANGCHAIN_API_KEY=
